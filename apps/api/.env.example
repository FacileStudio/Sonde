DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5603/sonde?sslmode=disable
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Journal log shipping (optional — per-app key from Journal's Keys page; internal URL http://journal-api:4010 on la ruche)
# JOURNAL_URL=http://journal-api:4010
# JOURNAL_TOKEN=journal_<app>_...

# Retention (optional): days of raw checks kept before pruning; hourly rollups live 13 months
# SONDE_RAW_RETENTION_DAYS=30

# Test database (optional): enables the PostgreSQL-backed tests in `go test ./...`
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5603/sonde_test?sslmode=disable

# Registration (optional): allow new accounts through POST /auth/register. The
# first account ever created becomes admin regardless.
# ALLOW_REGISTRATION=true

# Auth (porte). OIDC_ISSUER enables single sign-on against Authentik
# (porte.facile.studio) and makes the other four required — a half-filled set
# refuses to boot rather than failing on somebody's first login attempt.
# SSO_ONLY=true removes the password routes entirely; it requires an issuer.
#
# TRUST_EMAIL_WITHOUT_VERIFIED_CLAIM is deliberately NOT offered here:
# Authentik's built-in email scope hardcodes email_verified=false, so opting in
# would turn every callback into an account-takeover primitive against any
# pre-existing address. Leave it off.
#
# A failed OIDC login redirects to FailureURL (default /login on the success
# origin) with ?error=<reason>. The client must render that error OUTSIDE any
# SSO_ONLY gate — under SSO_ONLY this redirect is the only sign-in feedback
# there is.
# SSO_ONLY=false
# OIDC_ISSUER=https://porte.facile.studio/application/o/sonde/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://sonde.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://sonde.facile.studio/dashboard
