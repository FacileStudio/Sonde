DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5603/sonde?sslmode=disable
PORT=4000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Journal log shipping (optional; per-app key from Journal's Keys page; internal URL http://journal-api:4010 on la ruche)
# JOURNAL_URL=http://journal-api:4010
# JOURNAL_TOKEN=journal_<app>_...

# Retention (optional): days of raw checks kept before pruning; hourly rollups live 13
# months and daily rollups are never pruned. A value that is not an integer, or is below 1,
# falls back to 30 silently instead of failing at startup. See docs/RETENTION.md.
# SONDE_RAW_RETENTION_DAYS=30

# Test database (optional): enables the PostgreSQL-backed tests in `go test ./...`
# TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5603/sonde_test?sslmode=disable

# Auth (porte). OIDC_ISSUER enables single sign-on against Registre and makes the other four
# required; a half-filled set refuses to boot rather than failing on somebody's first login
# attempt. With an issuer set, porte never mounts a password route, and APP_ENV=production
# refuses to boot without one.
#
# Registre serves ONE issuer at the root: https://sso.facile.studio. It is not a per-app
# path. Authentik used to issue https://porte.facile.studio/application/o/<slug>/, that host
# is gone, and go-oidc compares the discovery document's issuer byte for byte, so no alias
# or trailing-slash variant works.
#
# TRUST_EMAIL_WITHOUT_VERIFIED_CLAIM is deliberately NOT offered here. Registre reports
# email_verified truthfully, so opting in would buy nothing and would weaken the guarantee
# against a provider that says nothing. Leave it off.
#
# OIDC_REDIRECT_URL must carry the /api prefix. Without it the request lands on the
# SvelteKit catch-all and returns 200 with HTML instead of 404, so the login just never
# completes and nothing logs an error.
#
# A failed OIDC login redirects to FailureURL (default /login on the success origin) with
# ?error=<reason>, which the login page shows.
# OIDC_ISSUER=https://sso.facile.studio
# OIDC_CLIENT_ID=sonde
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URL=https://sonde.facile.studio/api/auth/oidc/callback
# OIDC_SUCCESS_URL=https://sonde.facile.studio/dashboard

# CLI sign-in (optional): empty by default. Setting it mounts porte's device-exchange route
# so the companion CLI can sign in. Production value is facile-cli.
# OIDC_CLI_AUDIENCE=facile-cli

# Antenne event publishing (optional). ANTENNE_URL is the Antenne instance to publish to;
# ANTENNE_INSTANCE is its older spelling, and ANTENNE_URL wins when both are set. Leave both
# unset and publishing is disabled entirely: nothing dials and nothing is queued.
# ANTENNE_URL=
# ANTENNE_APP=sonde
# ANTENNE_SECRET=
# ANTENNE_INSTANCE_ID=

# Fleet maintenance (optional). SONDE_FLEET_TOKEN lets the scheduled runner deliver reports;
# unset it and ingest answers 404. Use at least 32 random characters. SONDE_FLEET_ADMINS is a
# comma-separated list of emails allowed to read fleet data; an administrator who is not on
# the list gets 403, and an empty list closes the read routes for everyone.
# SONDE_FLEET_TOKEN=
# SONDE_FLEET_ADMINS=you@example.com

# GitHub App (optional): the facile-fleet-scan App's client id (Iv23..., not the numeric App
# ID) and base64 of its PEM private key (`base64 -w0 key.pem`). The App mints one-hour tokens
# for the Rescan button (Actions write on FacileStudio/Sonde) and for checking which
# repositories a signed-in person may link (Metadata read). Set both or neither; unset, those
# features answer 412.
# SONDE_GITHUB_APP_CLIENT_ID=
# SONDE_GITHUB_APP_PRIVATE_KEY=
